# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8787
# Optional single shared password gate for the whole app. Leave blank to disable auth.
APP_PASSWORD=
# Random string used to sign session cookies. Change this.
SESSION_SECRET=change-me-to-a-long-random-string

# --- OneBound (Taobao / 1688 data provider) ---
# From https://www.onebound.cn/  (console -> API key / secret)
ONEBOUND_KEY=
ONEBOUND_SECRET=
# Gateway host. Do not change unless OneBound tells you to.
ONEBOUND_BASE=https://api-gw.onebound.cn

# --- Anthropic (Claude) — listing text, translations, alt text, "code" fields ---
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model. Any of the ids below can also be chosen per-request in the UI:
#   claude-opus-5  claude-opus-4-8  claude-opus-4-7  claude-opus-4-6
#   claude-sonnet-5  claude-sonnet-4-6  claude-haiku-4-5  claude-fable-5
LLM_MODEL=claude-sonnet-5

# --- Manus API v2 — image translation & detailed alt texts (agent tasks) ---
# API key from https://manus.im/  -> Settings -> API keys.
# The app auto-tries both `x-manus-api-key` (direct API key) and `Authorization: Bearer` (OAuth token).
MANUS_API_KEY=
MANUS_BASE=https://api.manus.ai
# Agent profile: manus-1.6 | manus-1.6-lite | manus-1.6-max
MANUS_AGENT_PROFILE=manus-1.6
# USD value of one Manus credit, for the cost dashboard (consumer tier ~= 0.01).
MANUS_USD_PER_CREDIT=0.005
# Image-translation tasks running at once. task.create calls are spaced out by
# MANUS_TASK_SPAWN_GAP_MS so a batch (e.g. 10 images) still clears the free-tier
# rate limit — just processed a few at a time.
MANUS_IMAGE_CONCURRENCY=6
# Min gap (ms) between Manus task.create calls across all jobs. 0 disables the
# throttle (paid plans); raise it if you still see "rate limit exceeded".
MANUS_TASK_SPAWN_GAP_MS=3500

# --- Shopify (optional: push generated products straight to a store) ---
# Admin API access token from a custom app: Settings -> Apps and sales channels -> Develop apps
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# --- Listing preview ---
# A live storefront product URL used as the reference layout for the final preview.
PREVIEW_REFERENCE_URL=https://keyartisan.net/products/cool-harry-potter-theme-keycap-set
